# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB (For Render/Production, use MongoDB Atlas connection string)
# e.g. MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=search_analytics

# SerpAPI Key (required for Google Trends live queries)
SERPAPI_KEY=

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins or * for all)
FRONTEND_ORIGIN=*

# App
ENVIRONMENT=development
